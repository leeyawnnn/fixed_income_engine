    authors:
      - family-names: Hagan
        given-names: Patrick S.
      - family-names: West
        given-names: Graeme
    title: Interpolation Methods for Curve Construction
    journal: Applied Mathematical Finance
    volume: 13
    issue: 2
    start: 89
    end: 129
    year: 2006
    doi: 10.1080/13504860500396032
